    "remotion": "4.0.529"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.529",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
